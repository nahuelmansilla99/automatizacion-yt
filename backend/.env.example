# Node Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de Datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=yt_summaries_db
DATABASE_SYNCHRONIZE=false

# n8n Automation Webhook
N8N_WEBHOOK_URL=

# Secreto compartido
WEBHOOK_SECRET=mi_super_secreto_webhook_12345

# Supadata API Key (para transcripciones)
SUPADATA_API_KEY=

# Google Gemini AI (para generación de resúmenes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# n8n Google Drive Webhook (Opcional, Fire & Forget para subir .md a Drive)
N8N_DRIVE_WEBHOOK_URL=