# Node Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8080

# Base de Datos PostgreSQL (Puerto 5434 para docker-compose.dev.yml o docker-compose.yml local)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=yt_summaries_db
DATABASE_SYNCHRONIZE=false

# n8n Automation Webhook (Trigger inicial que dispara el flujo)
# Ejemplos:
# Local: http://localhost:5678/webhook/youtube-summary
# Dokploy (red interna): http://n8n:5678/webhook/youtube-summary
# Dokploy (dominio público): https://n8n.ncodem.com/webhook/youtube-summary
N8N_WEBHOOK_URL=https://n8n.ncodem.com/webhook/youtube-summary

# Secreto compartido entre NestJS y n8n (header X-Webhook-Secret)
WEBHOOK_SECRET=mi_super_secreto_webhook_12345

# Supadata API Key (para transcripción de videos y métricas)
SUPADATA_API_KEY=

# Google Gemini AI (para generación de resúmenes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# n8n Google Drive Webhook (Opcional, Fire & Forget para subir .md a Drive)
N8N_DRIVE_WEBHOOK_URL=
