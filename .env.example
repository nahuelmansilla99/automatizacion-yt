# Servidor y Entorno
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Base de Datos PostgreSQL (Desarrollo local usa puerto 5434 para no colisionar)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres123
DATABASE_NAME=yt_summaries_db

# Integración n8n
# URL del webhook trigger en n8n que inicia el procesamiento
N8N_WEBHOOK_URL=http://localhost:5678/webhook/youtube-summary
# Secreto compartido para validar que los webhooks provienen de n8n (Header X-Webhook-Secret)
WEBHOOK_SECRET=mi_super_secreto_webhook_12345

# API de Supadata (Para métricas y consulta de cuenta /v1/me)
SUPADATA_API_KEY=tu_api_key_de_supadata_aqui
